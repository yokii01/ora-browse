# Environment Variables

# LLM Configuration
# Default: NVIDIA NIM (Nemotron)
LLM_PROVIDER=nvidia
NVIDIA_API_KEY=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
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/nemotron-3-ultra-550b-a55b

# Alternative: OpenAI
# LLM_PROVIDER=openai
# OPENAI_API_KEY=your-api-key-here
# OPENAI_BASE_URL=https://api.openai.com/v1

# For local models (Ollama, LM Studio)
# LLM_PROVIDER=local
# LOCAL_MODEL_BASE_URL=http://localhost:11434/v1

# For OpenRouter
# LLM_PROVIDER=openrouter
# OPENROUTER_API_KEY=your-api-key-here

# Model Selection (can use different models for different tasks)
PLANNER_MODEL=nvidia/nemotron-3-ultra-550b-a55b
ACTION_MODEL=nvidia/nemotron-3-ultra-550b-a55b
EXTRACTION_MODEL=nvidia/nemotron-3-ultra-550b-a55b
VERIFICATION_MODEL=nvidia/nemotron-3-ultra-550b-a55b

# Browser Configuration
DEFAULT_BROWSER=chromium
HEADLESS=true
DEFAULT_VIEWPORT_WIDTH=1280
DEFAULT_VIEWPORT_HEIGHT=720

# Security
DOMAIN_ALLOWLIST=*
DOMAIN_BLOCKLIST=
MAX_TASK_STEPS=50
MAX_RETRY_ATTEMPTS=3

# API Configuration
API_PORT=3001
API_HOST=localhost

# Database
DATABASE_PATH=./data/ora-browse.db

# Session Configuration
SESSION_TIMEOUT_MS=3600000
MAX_CONCURRENT_SESSIONS=5

# Logging
LOG_LEVEL=info
LOG_FILE=./logs/ora-browse.log

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
